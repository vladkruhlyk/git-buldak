# Куди падають заявки з форми на /form
# Скопіюйте цей файл у .env.local і підставте свої значення.
#
# Канали незалежні: можна ввімкнути обидва, можна лише один.

# --- Telegram ---
# Токен бота від @BotFather
TELEGRAM_BOT_TOKEN=

# ID отримувача. Можна кілька через кому: група + особистий чат
TELEGRAM_CHAT_ID=

# Необовʼязково: дзеркало/проксі Telegram API
# TELEGRAM_API_BASE=https://api.telegram.org

# --- Google-таблиця ---
# URL веб-додатку Apps Script (.../exec). Код і покрокова інструкція
# з підключення — у scripts/google-sheet.gs
GOOGLE_SHEET_WEBHOOK_URL=

# Той самий рядок, що вписаний у SECRET всередині скрипта
GOOGLE_SHEET_SECRET=
